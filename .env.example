# Public portfolio origin. Set the real domain before the production build.
# Absolute HTTP(S) URL, without a subpath, query or fragment. No invented fallback.
# Leave empty locally; canonical, sharing images and sitemap URLs are omitted.
SITE_URL=

# Windows 7 photography gallery and catalog video streaming (server only).
# Copy to .env.local. Never use NEXT_PUBLIC_ for the API key.
# Enable Google Drive API v3 in your Google Cloud project.
# Share the root folder and its contents as Anyone with the link (Viewer).
# DRIVE_FOLDER_ID accepts the ID or the complete https://drive.google.com folder link.
DRIVE_FOLDER_ID=
GOOGLE_DRIVE_API_KEY=

# Optional: resourcekey value from a public folder link, if required.
DRIVE_FOLDER_RESOURCE_KEY=

# GOOGLE_DRIVE_API_KEY also enables real WMP12 controls for Drive shorts.
# Without the key, shorts fall back to Drive /preview. Longs/profile still work.
# DRIVE_FOLDER_ID and optional resource key remain specific to photography.
